# Copier ce fichier en .env.local et renseigner les valeurs réelles.
# Voir le README ("Google Calendar — Sprint 2", "Base de données — Sprint 4") pour la
# procédure complète (Google Cloud Console, Postgres local).

# Base de données (voir infra/docker-compose.yml pour un Postgres local)
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Clé de chiffrement du refresh_token Google stocké en base (32 octets encodés en base64).
# Générer avec : openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=
