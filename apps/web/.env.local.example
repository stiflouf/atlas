# Copier ce fichier en .env.local et renseigner les valeurs réelles.
# Voir le README ("Google Calendar — Sprint 2") pour la procédure complète
# de création des credentials dans Google Cloud Console.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Clé de chiffrement du cookie de tokens (32 octets encodés en base64).
# Générer avec : openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=
