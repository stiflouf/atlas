# Copier ce fichier en .env.local et renseigner les valeurs réelles.
# Voir le README ("Google Calendar — Sprint 2", "Base de données — Sprint 4") pour la
# procédure complète (Google Cloud Console, Postgres local).

# Base de données (voir infra/docker-compose.yml pour un Postgres local)
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Clé de chiffrement du refresh_token Google stocké en base (32 octets encodés en base64).
# Générer avec : openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Clé PRIM (Île-de-France Mobilités) — inscription gratuite sur prim.iledefrance-mobilites.fr,
# abonnement à l'API "Navitia - Calcul d'itinéraire".
PRIM_API_KEY=

# Secret partagé protégeant POST /api/automatisations/scan (ADR-033, moteur temporel) — à
# transmettre en en-tête `Authorization: Bearer <secret>` par le cron externe qui déclenche le
# scan périodiquement (aucun cron interne à Atlas). Générer avec : openssl rand -base64 32.
# Sans cette variable, l'endpoint répond 503 : le moteur temporel ne s'exécute jamais spontanément.
AUTOMATISATIONS_SCAN_SECRET=

# Secret partagé protégeant POST /api/compatibilite/scan (ADR-036, filet de reprise de la
# resynchronisation de compatibilité) — même principe qu'AUTOMATISATIONS_SCAN_SECRET, endpoint
# distinct. Générer avec : openssl rand -base64 32.
COMPATIBILITE_SCAN_SECRET=

# Secret DÉDIÉ (distinct du précédent) protégeant POST /api/compatibilite/baseline (ADR-036, outil
# explicite de baseline/rebuild) — geste manuel délibéré, jamais un cron automatique. Générer avec :
# openssl rand -base64 32.
COMPATIBILITE_BASELINE_SECRET=

# Secret DÉDIÉ protégeant POST /api/automatisations/reprise (ADR-038, filet de reprise des
# executions_automatisation restées bloquées après un crash) — distinct d'AUTOMATISATIONS_SCAN_SECRET
# (responsabilité distincte). Générer avec : openssl rand -base64 32.
AUTOMATISATIONS_REPRISE_SECRET=

# --- Sécurisation du pilote mono-conseiller (ADR-047) ---
# Distincte de GOOGLE_REDIRECT_URI (autorisations Calendar/Gmail) : ce flux ne demande QUE
# l'identité (openid+email), jamais un accès Calendar/Gmail, jamais de refresh_token.
GOOGLE_ATLAS_REDIRECT_URI=http://localhost:3000/api/auth/atlas/callback

# UNE seule adresse autorisée à entrer dans Atlas (mono-conseiller, ADR-047 — jamais une allowlist
# à plusieurs entrées, voir docs/adr/047-securisation-pilote-mono-conseiller.md). Comparée après
# normalisation (trim + lowercase) à l'email confirmé par l'id_token Google. Sans cette variable,
# aucune identité n'est jamais autorisée (fail-closed).
ATLAS_ALLOWED_EMAIL=

# Clé de scellement de la session Atlas (iron-session, cookie chiffré côté client, jamais de table
# de session en base) — 32 caractères minimum. Générer avec : openssl rand -base64 32.
# Sans cette variable (ou trop courte), Atlas refuse toute lecture/création de session — jamais une
# ouverture publique silencieuse.
ATLAS_SESSION_PASSWORD=
